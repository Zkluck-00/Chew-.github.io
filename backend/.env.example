# Crear un .env privado en backend-java (NO compartir credenciales reales)
PGHOST=TU_HOST_DE_NEON
PGDATABASE=neondb
PGUSER=TU_USUARIO_DE_NEON
PGPASSWORD=TU_PASSWORD_DE_NEON
PGSSLMODE=require
PGCHANNELBINDING=require

# Se crea el ADMIN inicial al arrancar Spring si no existe.
CHEW_ADMIN_USER=
CHEW_ADMIN_PASSWORD=
# 32 bytes o mas, generados de forma aleatoria para firmar JWT HS256
CHEW_JWT_SECRET=
